# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

# ---------------------------------------------------------------------------
# PostgreSQL (used by docker-compose and by the backend's DATABASE_URL)
# ---------------------------------------------------------------------------
POSTGRES_USER=ticket_user
POSTGRES_PASSWORD=ticket_pass
POSTGRES_DB=ticket_router
POSTGRES_PORT=5432

# SQLAlchemy connection string (psycopg3 driver). Must match the values above
# when running against the docker-compose database on localhost.
DATABASE_URL=postgresql+psycopg://ticket_user:ticket_pass@localhost:5432/ticket_router

# ---------------------------------------------------------------------------
# Backend app settings
# ---------------------------------------------------------------------------
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
MAX_TICKET_MESSAGE_LENGTH=4000

# ---------------------------------------------------------------------------
# LLM routing service
# provider: "mock" (default, no key needed, uses rule-based classification)
#           or "anthropic" (real Claude calls)
# ---------------------------------------------------------------------------
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=your-anthropic-api-key-here
LLM_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Embedding service (for pgvector similarity search)
# provider: "mock" (default, no key needed, deterministic pseudo-embeddings,
#           NOT real semantic search — see README for limitations)
#           or "openai" (real embedding calls)
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=mock
OPENAI_API_KEY=your-openai-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384

# ---------------------------------------------------------------------------
# Authentication
# cookie_secure must be true in production (HTTPS only) — leave false for
# local http://localhost dev, where a Secure cookie would never be sent.
# ---------------------------------------------------------------------------
COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=12
PASSWORD_RESET_TOKEN_LIFETIME_MINUTES=30
EMAIL_VERIFICATION_TOKEN_LIFETIME_HOURS=24
AGENT_INVITATION_LIFETIME_DAYS=7

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
